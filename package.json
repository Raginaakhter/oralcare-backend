{
  "name": "oralcare-backend",
  "version": "1.0.0",
  "description": "Backend API for OralCare e-commerce platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "ai:demo": "tsx scripts/claudeApiDemo.ts"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
